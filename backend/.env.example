# --- Server ---
# 5000 is taken by AirPlay Receiver on macOS; 5050 avoids that clash.
PORT=5050
NODE_ENV=development
CLIENT_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:19006

# --- Database ---
# NOTE: this file is only a TEMPLATE. Copy it to `.env` and edit THAT file —
# nothing here is ever read at runtime, and real credentials do not belong here.
#
# Local:  mongodb://127.0.0.1:27017/aura
# Atlas:  mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/aura?retryWrites=true&w=majority
#         - the database name (/aura) is required, before the "?"
#         - percent-encode specials in the password: @ %40  # %23  / %2F  : %3A
# Check it any time with: npm run db:check
MONGODB_URI=mongodb://127.0.0.1:27017/aura

# --- Auth ---
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Login/register attempts per IP per 15 minutes. Keep it low in production;
# raise it locally if you re-run `npm run test:e2e` repeatedly.
AUTH_RATE_LIMIT=20

# --- Seed admin (used by `npm run seed`) ---
SEED_ADMIN_NAME=Platform Admin
SEED_ADMIN_EMAIL=admin@aura.dev
SEED_ADMIN_PASSWORD=Admin@12345
