# Used by `vite build` only (Vite loads .env.production for the production mode).
#
# Kept out of .env on purpose: .env is read by `npm run dev` too, and pointing local
# development at the live API would mean every archive, delete and approve you click
# while developing lands on production data.
VITE_API_BASE_URL=https://influencer-website-app.onrender.com
